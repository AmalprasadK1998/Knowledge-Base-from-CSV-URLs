# Django secret key — CHANGE IN PRODUCTION. Generated via `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`.
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-please-0123456789abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Optional: Groq (free-tier) API key for LLM answer synthesis.
# Get one at https://console.groq.com/keys. Leave blank to use the built-in
# extractive summarizer (no network/model needed).
GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Google API key for LLM answer synthesis and embeddings.
# Get one of free tier from google AI studio. Leave blank to use the built-in extractive summarizer (no network/model needed).
GOOGLE_API_KEY=google_api_key_here
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_MODEL=gemini-3.1-flash-lite


# Optional: a real sentence-transformer model for higher-quality embeddings.
# Leave blank to use the built-in TF-IDF embedding (no model download).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Scraping tuning
SCRAPER_TIMEOUT=20
SCRAPER_MAX_PAGES=50
